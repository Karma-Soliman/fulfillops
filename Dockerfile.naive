# Baseline for size comparison only, never deployed.
FROM python:3.12@sha256:cad37dd20c7cac861af9003af8796d03ea7a998ec1e3a664429740fc9d7d2691
WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY api /app/api
COPY worker /app/worker
COPY db /app/db
COPY alembic.ini /app/alembic.ini
COPY docker/entrypoint.sh /usr/local/bin/fulfillops
RUN chmod 0555 /usr/local/bin/fulfillops
EXPOSE 8080 9100
ENTRYPOINT ["/usr/local/bin/fulfillops"]
CMD ["api"]
