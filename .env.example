DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/fulfillops
POSTGRES_USER=fulfillops
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=fulfillops
FULFILLOPS_IMAGE=fulfillops:dev
DB_POOL_SIZE=5
WORKER_LEASE_SECONDS=10
WORKER_MAX_ATTEMPTS=3
WORKER_RENEW_INTERVAL_SECONDS=3
WORKER_BACKOFF_BASE_SECONDS=1
WORKER_BACKOFF_MAX_SECONDS=8
WORKER_POLL_INTERVAL_SECONDS=0.5
